DATABASE_URL=postgresql+psycopg://messenger_user:messenger_password@localhost:5432/messenger_db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173

UPLOADS_DIR=uploads
VOICE_UPLOAD_URL_PREFIX=/uploads/voice
FILE_UPLOAD_URL_PREFIX=/uploads/files
VOICE_MESSAGE_MAX_BYTES=10485760
FILE_MESSAGE_MAX_BYTES=26214400

LOGIN_RATE_LIMIT_PER_MINUTE=100
SIGNUP_RATE_LIMIT_PER_MINUTE=200
MESSAGE_RATE_LIMIT_PER_MINUTE=300
UPLOAD_RATE_LIMIT_PER_MINUTE=100
